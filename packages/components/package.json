{
  "name": "@agentforge/components",
  "version": "0.1.0",
  "description": "AgentForge UI组件库 - 为AI Agent应用设计的React组件",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && vite build",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ui-components",
    "react",
    "agent-forge",
    "typescript"
  ],
  "author": "AgentForge Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.10",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
