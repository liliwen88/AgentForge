{
  "name": "agentforge",
  "version": "0.1.0",
  "description": "专为业务开发设计的TypeScript全栈+AI脚手架，让AI Agent开发像搭积木一样简单",
  "packageManager": "pnpm@8.15.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentforge": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "cli": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "typescript",
    "scaffolding",
    "full-stack",
    "business-development",
    "llm",
    "agent-framework"
  ],
  "author": "AgentForge Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentforge/agentforge.git"
  },
  "bugs": {
    "url": "https://github.com/agentforge/agentforge/issues"
  },
  "homepage": "https://agentforge.dev",
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    ".github",
    ".windsurf",
    ".cursor"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.8",
    "semver": "^7.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/inquirer": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/semver": "^7.5.5",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "rimraf": "^5.0.0",
    "turbo": "^1.11.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
